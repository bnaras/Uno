# Hand-managed for now. Native routines registered by cpp11 (src/cpp11.cpp);
# R stubs for [[cpp11::register]] functions in R/cpp11.R (cpp11::cpp_register()).
useDynLib(Uno, .registration = TRUE)

# rmumps provides MUMPS' dmumps_c at run time (bound in .onLoad through the
# C-callables rmumps registers; src/dmumps_shim.c). Importing it ensures
# rmumps' namespace -- and thus its shared object -- is loaded whenever Uno's
# namespace loads.
importFrom(rmumps, Rmumps)

export(uno_version)
export(uno_solve)
export(uno_options)
export(uno_status_labels)
export(uno_mumps_version)
