#!/bin/sh
#
# configure.win -- Windows build of the Uno R package (Rtools/MinGW).
#
# Mirrors ./configure (writing src/Makevars.win), MUMPS included.  The
# interior-point ("ipopt") preset reaches MUMPS at runtime from the 'rmumps'
# package; src/dmumps_shim.c resolves dmumps_c via R_GetCCallable("rmumps",
# "dmumps_c"), the C-callable rmumps registers (>= 5.2.1-43).  That registry
# works on Windows, unlike the old R_FindSymbol route (a Windows DLL exports
# only symbols it explicitly declares, and rmumps does not export dmumps_c as a
# dynamic symbol).  So the Windows build now enables the same MUMPS path as
# Linux/macOS, and the ipopt/MUMPS tinytests run here too.

R_UNO_PKG_HOME=`pwd`

: ${R_HOME=`R RHOME`}
if test -z "${R_HOME}"; then
    echo "'R_HOME' could not be found!"
    exit 1
fi

# Locate the MUMPS C-API headers shipped by the 'rmumps' package (mirrors
# ./configure). build_uno.sh compiles Uno's MUMPSSolver.cpp against these
# (header-only); we link NO MUMPS library -- dmumps_c is resolved at runtime
# from rmumps via R_GetCCallable (see src/dmumps_shim.c). This enables the
# interior-point ("ipopt") preset. Skip with R_UNO_NO_MUMPS=1 (HiGHS only).
if test -z "${R_UNO_NO_MUMPS}"; then
    RMUMPS_INC=`"${R_HOME}/bin/Rscript" -e 'cat(system.file("include", package="rmumps"))'`
    if test -z "${RMUMPS_INC}" || test ! -f "${RMUMPS_INC}/dmumps_c.h"; then
        echo "rmumps headers not found (looked in '${RMUMPS_INC}')."
        echo "Install 'rmumps' (>= 5.2.1-43), or set R_UNO_NO_MUMPS=1 to build without MUMPS."
        exit 1
    fi
    export MUMPS_R_INCLUDE_DIRS="${RMUMPS_INC}"
    echo "MUMPS headers (rmumps): ${MUMPS_R_INCLUDE_DIRS}"
fi

# Build the HiGHS QP/LP subproblem solver (static libhighs.a) from source.
HIGHS_PKG_LIBS=""
if test -z "${R_UNO_NO_HIGHS}"; then
    bash inst/build_highs.sh || { echo "HiGHS build failed!"; exit 1; }
    cd "${R_UNO_PKG_HOME}"
    R_HIGHS_LIB_DIR=${R_UNO_PKG_HOME}/src/highslib
    export HIGHS_LIB="${R_HIGHS_LIB_DIR}/lib/libhighs.a"
    HIGHS_PKG_LIBS="-L${R_HIGHS_LIB_DIR}/lib -lhighs"
fi

# Build the Uno static library (src/unolib/{lib,include}).
bash inst/build_uno.sh || { echo "Uno build failed!"; exit 1; }
cd "${R_UNO_PKG_HOME}"

# The bundled HiGHS/Uno source trees are kept out of the *installed* package via
# the top-level .Rinstignore (see ./configure), NOT deleted from the tarball here.

# Remove the intermediate CMake build trees (their generated Makefiles carry
# CRLF on Windows -> "line endings in Makefiles" WARNING).
rm -rf highs_build uno_build

# Normalize the installed HiGHS/Uno headers: strip CRLF -> LF and ensure a
# trailing newline, so R CMD check's "line endings in sources" and "not
# terminated with a newline" NOTEs stay clear.  No-ops on already-clean files.
for incdir in src/highslib/include src/unolib/include; do
    test -d "${incdir}" || continue
    find "${incdir}" -type f -print | while read f; do
        tr -d '\r' < "$f" > "$f.tmp"
        if test -s "$f.tmp" && test -n "$(tail -c1 "$f.tmp")"; then
            printf '\n' >> "$f.tmp"
        fi
        mv "$f.tmp" "$f"
    done
done

R_UNO_LIB_DIR=${R_UNO_PKG_HOME}/src/unolib

RUNO_PKG_LIBS="-L${R_UNO_LIB_DIR}/lib -luno ${HIGHS_PKG_LIBS}"

sed -e "s|@RUNO_LIB_DIR@|${R_UNO_LIB_DIR}|g" \
    -e "s|@RUNO_PKG_LIBS@|${RUNO_PKG_LIBS}|g" \
    src/Makevars.in > src/Makevars.win

if [ -z "$(ls ${R_UNO_LIB_DIR} 2>/dev/null | grep 'include')" ]; then
    echo "Uno headers could not be found!"
    exit 1
fi
